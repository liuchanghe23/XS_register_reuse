+/* SPDX-License-Identifier: BSD-3-Clause */
+#ifndef __CPU_O3_REGISTER_REUSE_HH__
+#define __CPU_O3_REGISTER_REUSE_HH__
+#include <map>
+#include <vector>
+#include "base/statistics.hh"
+#include "cpu/inst_seq.hh"
+#include "cpu/o3/dyn_inst_ptr.hh"
+#include "cpu/o3/register_reuse_state.hh"
+#include "cpu/o3/regfile.hh"
+
+namespace gem5
+{
+struct BaseO3CPUParams;
+namespace o3
+{
+class CPU;
+class UnifiedRenameMap;
+class UnifiedFreeList;
+class Scoreboard;
+
+/** Bounded scalar INT/FP sharing with version tags and shadow values. */
+class RegisterReuse : public statistics::Group
+{
+  public:
+    RegisterReuse(CPU *cpu, const BaseO3CPUParams &params);
+    const bool enabled;
+    PhysRegIdPtr candidate(const DynInstPtr &inst, UnifiedRenameMap &map,
+                           bool count = false);
+    PhysRegIdPtr reuse(PhysRegIdPtr source, const DynInstPtr &inst);
+    void allocated(PhysRegIdPtr reg, const DynInstPtr &inst);
+    void renamed(const DynInstPtr &inst);
+    PhysRegIdPtr release(PhysRegIdPtr reg);
+    bool prepare(const DynInstPtr &inst, UnifiedRenameMap &map,
+                 UnifiedFreeList &free, Scoreboard &scoreboard);
+    VirtRegId source(const DynInstPtr &inst, VirtRegId original) const;
+    void commit(InstSeqNum seq);
+    void squash(InstSeqNum seq);
+    bool recovering() const;
+
+  private:
+    struct Event {
+        std::vector<PhysRegIdPtr> reads;
+        std::vector<std::pair<PhysRegIdPtr, PhysRegIdPtr>> repairs;
+    };
+    CPU *cpu;
+    unsigned numInt, numFloat, shadows, repairLatency, recoveryLatency;
+    bool prediction;
+    std::vector<ReuseSlot> slots;
+    std::vector<uint8_t> predictor;
+    std::map<InstSeqNum, Event> events;
+    InstSeqNum waitingSeq = 0;
+    uint64_t waitingUntil = 0, recoveryUntil = 0;
+    int slotIndex(PhysRegIdPtr reg) const;
+    ReuseSlot &slot(PhysRegIdPtr reg);
+    const ReuseSlot &slot(PhysRegIdPtr reg) const;
+    void returnTemporary(PhysRegIdPtr reg);
+
+    statistics::Scalar allocatedSlots;
+    statistics::Scalar sharedVersions;
+    statistics::Scalar deterministicReuses;
+    statistics::Scalar predictedReuses;
+    statistics::Scalar predictionMisses;
+    statistics::Scalar repairCopies;
+    statistics::Scalar repairWaitCycles;
+    statistics::Scalar aliasRejects;
+    statistics::Scalar versionLimitRejects;
+    statistics::Scalar squashEvents;
+    statistics::Scalar restoredGroups;
+    statistics::Scalar returnedSlots;
+};
+} // namespace o3
+} // namespace gem5
+#endif

diff --git a/src/cpu/o3/register_reuse_state.hh b/src/cpu/o3/register_reuse_state.hh
new file mode 100644
index 0000000000..536af6d300
--- /dev/null
+++ b/src/cpu/o3/register_reuse_state.hh
@@ -0,0 +1,62 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+#ifndef __CPU_O3_REGISTER_REUSE_STATE_HH__
+#define __CPU_O3_REGISTER_REUSE_STATE_HH__
+#include <array>
+#include <cassert>
+#include <cstdint>
+
+namespace gem5::o3
+{
+/** Monotonic version numbers: a squash cannot cause tag ABA within a slot. */
+struct ReuseSlot
+{
+    struct Version {
+        bool live = false;
+        unsigned reads = 0;
+        uint64_t producer = 0;
+        uint64_t pc = 0;
+        unsigned committedReads = 0; // Saturates at two; reads counts in-flight tokens only.
+    };
+    std::array<Version, 4> versions{};
+    unsigned highWater = 0;
+
+    void allocate(uint64_t producer, uint64_t pc)
+    {
+        assert(empty());
+        *this = ReuseSlot{};
+        versions[0] = {true, 0, producer, pc};
+    }
+    bool empty() const
+    {
+        for (const auto &v : versions)
+            if (v.live) return false;
+        return true;
+    }
+    unsigned current() const
+    {
+        for (unsigned v = highWater; v > 0; --v)
+            if (versions[v].live) return v;
+        return 0;
+    }
+    bool canReuse(unsigned version, unsigned shadows) const
+    {
+        return versions[version].live && !versions[version].reads &&
+               !versions[version].committedReads &&
+               version == current() && highWater < shadows;
+    }
+    unsigned reuse(uint64_t producer, uint64_t pc)
+    {
+        assert(highWater < 3);
+        const unsigned v = ++highWater;
+        assert(!versions[v].live);
+        versions[v] = {true, 0, producer, pc};
+        return v;
+    }
+    void release(unsigned version)
+    {
+        assert(versions[version].live);
+        versions[version].live = false;
+    }
+};
+} // namespace gem5::o3
+#endif

diff --git a/src/cpu/o3/register_reuse_state.test.cc b/src/cpu/o3/register_reuse_state.test.cc
new file mode 100644
index 0000000000..aa39490d5d
--- /dev/null
+++ b/src/cpu/o3/register_reuse_state.test.cc
@@ -0,0 +1,74 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+#include <gtest/gtest.h>
+#include "cpu/o3/register_reuse_state.hh"
+using gem5::o3::ReuseSlot;
+
+TEST(RegisterReuseState, DistinctVersionsAndBoundedShadows)
+{
+    ReuseSlot s;
+    s.allocate(10, 0x8000);
+    EXPECT_TRUE(s.canReuse(0, 3));
+    EXPECT_EQ(s.reuse(11, 0x8004), 1);
+    EXPECT_FALSE(s.canReuse(0, 3));
+    EXPECT_EQ(s.reuse(12, 0x8008), 2);
+    EXPECT_EQ(s.reuse(13, 0x800c), 3);
+    EXPECT_FALSE(s.canReuse(3, 3));
+    EXPECT_EQ(s.versions[0].producer, 10);
+    EXPECT_EQ(s.versions[3].producer, 13);
+}
+
+TEST(RegisterReuseState, SquashNeverReusesDependencyTag)
+{
+    ReuseSlot s;
+    s.allocate(10, 0x8000);
+    s.reuse(11, 0x8004);
+    s.release(1);
+    EXPECT_EQ(s.current(), 0);
+    EXPECT_TRUE(s.canReuse(0, 3));
+    EXPECT_EQ(s.reuse(12, 0x8008), 2);
+    EXPECT_EQ(s.highWater, 2);
+}
+
+TEST(RegisterReuseState, SlotCannotBeReturnedWithAnOlderLiveVersion)
+{
+    ReuseSlot s;
+    s.allocate(10, 0x8000);
+    s.reuse(11, 0x8004);
+    s.release(1);
+    EXPECT_FALSE(s.empty());
+    s.release(0);
+    EXPECT_TRUE(s.empty());
+    s.allocate(12, 0x9000);
+    EXPECT_EQ(s.highWater, 0);
+}
+
+TEST(RegisterReuseState, PriorConsumerDisqualifiesReuse)
+{
+    ReuseSlot s;
+    s.allocate(10, 0x8000);
+    ++s.versions[0].reads;
+    EXPECT_FALSE(s.canReuse(0, 3));
+    --s.versions[0].reads;
+    EXPECT_TRUE(s.canReuse(0, 3));
+}
+
+TEST(RegisterReuseState, OneShadowIsAHardCapacityLimit)
+{
+    ReuseSlot s;
+    s.allocate(10, 0x8000);
+    s.reuse(11, 0x8004);
+    EXPECT_FALSE(s.canReuse(1, 1));
+    s.release(0);
+    EXPECT_FALSE(s.canReuse(1, 1));
+}
+
+TEST(RegisterReuseState, CommittedReadPreventsReuseAfterSpeculativeTokenRetires)
+{
+    ReuseSlot s;
+    s.allocate(10, 0x8000);
+    s.versions[0].committedReads = 1;
+    EXPECT_FALSE(s.canReuse(0, 3));
+    ++s.versions[0].reads;
+    --s.versions[0].reads;
+    EXPECT_FALSE(s.canReuse(0, 3));
+}

