@@ -0,0 +1,299 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+#include "cpu/o3/register_reuse.hh"
+
+#include <algorithm>
+#include <set>
+
+#include "cpu/o3/cpu.hh"
+#include "cpu/o3/dyn_inst.hh"
+#include "cpu/o3/issue_queue.hh"
