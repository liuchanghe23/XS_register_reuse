+void
+Rename::recordPressureStall(ThreadID tid)
+{
+    if (!regPressure.enabled || fixedbuffer[tid].empty())
+        return;
+    constexpr RegClassType classes[] = {
+        IntRegClass, FloatRegClass, VecRegClass, RMiscRegClass};
+    std::array<unsigned, 4> free{}, demand{};
+    for (unsigned c = 0; c < 4; ++c) {
+        free[c] = renameMap[tid]->numFreeEntries(classes[c]);
+        demand[c] = renameWidth;
+        unsigned actual = 0;
+        for (unsigned i = 0; i < std::min<unsigned>(
+                 fixedbuffer[tid].size(), renameWidth); ++i) {
+            const auto &inst = fixedbuffer[tid][i];
+            if (!inst->isSquashed())
+                actual += inst->numDestRegs(classes[c]);
+        }
+        demand[c] = std::max(demand[c], actual);
+    }
+    regPressure.stall(free, demand);
+}
